{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "sweg-focus-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "workspace",
              "type": "column",
              "size": {
                "px": 344
              },
              "min": 300,
              "max": 480,
              "children": [
                {
                  "id": "workspace-head",
                  "type": "block",
                  "content": {
                    "mod": "sweg-focus-panel",
                    "props": {
                      "part": "head"
                    }
                  },
                  "size": {
                    "px": 40
                  }
                },
                {
                  "id": "workspace-body",
                  "type": "stack",
                  "active": "ws-files",
                  "children": [
                    {
                      "id": "ws-files",
                      "type": "block",
                      "content": {
                        "mod": "sweg-focus-files"
                      }
                    },
                    {
                      "id": "ws-git",
                      "type": "block",
                      "content": {
                        "mod": "sweg-focus-changes"
                      }
                    },
                    {
                      "id": "ws-px0",
                      "type": "block",
                      "content": {
                        "mod": "sweg-focus-px0"
                      }
                    }
                  ]
                },
                {
                  "id": "workspace-foot",
                  "type": "block",
                  "content": {
                    "mod": "sweg-focus-panel",
                    "props": {
                      "part": "foot"
                    }
                  },
                  "size": {
                    "px": 28
                  }
                }
              ]
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "sweg-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "row",
          "children": [
            {
              "id": "status-info",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "status-stats",
              "type": "block",
              "content": {
                "mod": "system-stats"
              },
              "size": {
                "px": 210
              }
            }
          ],
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "sweg-menu"
}
